<!--
  Panel, Button, ButtonIcon, and ButtonLabel come from the bundled Horizon kit.
  RectangleGoggles and LogIn are bundled Lucide icon components.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 600px;
  }

  .panel-content {
    flex-direction: column;
    gap: 8px;
    padding: 24px;
  }

  .eyebrow {
    color: #58a6ff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .heading {
    color: #fafaf7;
    font-size: 28px;
    font-weight: 700;
    line-height: 34px;
  }

  .body {
    color: #8b949e;
    font-size: 16px;
    line-height: 22px;
  }

  .scenario-card {
    flex-direction: column;
    background-color: #161b22;
    border-radius: 8px;
    padding: 12px;
    gap: 4px;
    margin-top: 8px;
  }

  .scenario-tag {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .scenario-stats {
    color: #8b949e;
    font-size: 13px;
    line-height: 18px;
  }

  .scenario-mission {
    color: #e6edf3;
    font-size: 13px;
    line-height: 18px;
  }

  .success-banner {
    background-color: #238636;
    border-radius: 8px;
    padding: 12px;
    margin-top: 8px;
    justify-content: center;
  }

  .success-text {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 24px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">PORT PILOT BRIEFING</div>
    <div class="heading">TomeXR - Hands-first mooring planner</div>
    <div id="scenario-card-1" class="scenario-card">
      <div class="scenario-tag" style="color: #3fb950">SCENARIO 1: CALM HARBOR</div>
      <div class="scenario-stats">Wind: Calm (0 kts) | Current: None</div>
      <div class="scenario-mission">Goal: Basic training. Guide vessel into green berth.</div>
    </div>
    <div id="scenario-card-2" class="scenario-card" style="display: none">
      <div class="scenario-tag" style="color: #f0883e">SCENARIO 2: OFFSHORE CROSSWIND</div>
      <div class="scenario-stats">Wind: 18 kts (Offshore) | Current: None</div>
      <div class="scenario-mission">Goal: Wind blows ship to sea. Deploy bow tug to counter drift!</div>
    </div>
    <div id="scenario-card-3" class="scenario-card" style="display: none">
      <div class="scenario-tag" style="color: #ff7b72">SCENARIO 3: STORM & TIDAL CURRENT</div>
      <div class="scenario-stats">Wind: 22 kts | Current: 1.5 kts East</div>
      <div class="scenario-mission">Goal: High drift. Deploy both tugs to stabilize heading!</div>
    </div>
    <div id="dock-success" class="success-banner" style="display: none">
      <div class="success-text">✓ DOCKED SAFELY! MISSION COMPLETE</div>
    </div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
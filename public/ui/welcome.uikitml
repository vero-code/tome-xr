<!--
  Panel, Button, ButtonIcon, and ButtonLabel come from the bundled Horizon kit.
  RectangleGoggles and LogIn are bundled Lucide icon components.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 440px;
  }

  .panel-content {
    flex-direction: column;
    gap: 8px;
    padding: 24px;
  }

  .eyebrow {
    color: #58a6ff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .heading {
    color: #fafaf7;
    font-size: 28px;
    font-weight: 700;
    line-height: 34px;
  }

  .body {
    color: #8b949e;
    font-size: 17px;
    line-height: 24px;
  }

  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 24px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">PORT PILOT BRIEFING</div>
    <div class="heading">TomeXR Planner</div>
    <div class="body">Hands-first seated tactical mooring.</div>
    <div class="body">Pinch hull & tugboats to guide cargo vessel.</div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>